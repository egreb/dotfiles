workspace_root: ~/sandboxes
projects_file: ~/.config/sbx/projects.yaml
git_cache_root: ~/.cache/sbx/git
agent: claude
claude_theme: dark
# Memory limit per sandbox (passed as sbx create --memory). Empty uses the
# sbx default of 50% of host memory.
sandbox_memory: 8g
host_shell: fish
tmux_socket: sbx-v1
# Optional; omitted means tmux loads your normal user config.
# tmux_config: ~/.tmux.conf
# Must be Docker's native executable, not this wrapper.
docker_sbx_bin: /opt/homebrew/bin/sbx
