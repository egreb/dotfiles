#!/usr/bin/env fish
# Show and preview git diffs through fzf. Anything you can pass to git diff
# you can pass to this script. It also supports passing in --side to configure
# delta to use side-by-side mode.
#
# Examples:
#   gd
#   gd --side
#   gd --staged
#   gd [any flag that git diff supports]

set -l git_args --color=always

for arg in $argv
    if test "$arg" = --side
        set -gx DELTA_FEATURES "$DELTA_FEATURES side-by-side"
    else
        set -a git_args $arg
    end
end

set -l git_args_str (string escape -- $git_args)

git diff $git_args --name-only |
    fzf \
        --preview "git diff $git_args_str -- ':(top){-1}' | delta --width=\$FZF_PREVIEW_COLUMNS" \
        --preview-window="right,75%"

true
